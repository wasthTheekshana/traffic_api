GOOGLE_API_KEY=your_google_routes_api_key_here
# every 60 min, aligned to the clock (06:00, 07:00 ...)
INTERVAL_SECONDS=3600
# local hours to collect, inclusive: 6-21 = 16 runs/day
ACTIVE_HOURS=6-21
# hard caps inside the code (Google free tier = 5,000/month)
DAILY_LIMIT=160
MONTHLY_LIMIT=4900
TZ=Asia/Colombo
